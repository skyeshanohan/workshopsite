---
import { profile } from '../data/profile.js';
const allowedThemes = ['editorial', 'developer', 'professional'];
const theme = allowedThemes.includes(profile.theme) ? profile.theme : 'editorial';
const initials = profile.name.split(' ').map((word) => word[0]).slice(0, 2).join('').toUpperCase();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={profile.tagline} />
  <title>{profile.name} · Portfolio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Titillium+Web:wght@400;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body class:list={['theme-' + theme]}>
  <header class="topbar">
    <a class="monogram" href="#top" aria-label="Back to top">{initials}<span>.</span></a>
    <nav aria-label="Main navigation"><a href="#about">About</a><a href="#experience">Experience</a><a href="#projects">Projects</a><a href="#contact">Contact</a></nav>
    <a class="top-contact" href="#contact">Let's connect ↗</a>
  </header>
  <main>
    <section class="hero" id="top">
      <div class="hero-copy">
        <p class="eyebrow">PORTFOLIO · {profile.location.toUpperCase()}</p>
        <h1>{profile.name}<span class="accent">.</span></h1>
        <h2>{profile.role}</h2>
        <p class="intro">{profile.tagline} {profile.about}</p>
        <div class="actions"><a class="button primary" href="#projects">Explore my work ↓</a><a class="button secondary" href={'mailto:' + profile.email}>Contact me ↗</a></div>
        <div class="socials"><a href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a><a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a></div>
      </div>
      <div class="hero-art" aria-label="Profile card">
        <div class="orbit"></div>
        <div class="profile-card"><span class="tiny-label">A LITTLE ABOUT ME</span><div class="initials">{initials}</div><h3>{profile.name}</h3><p>{profile.role}</p><div class="yellow-rule"></div><span class="tiny-label">LEARN · BUILD · SHARE</span></div>
        <span class="vertical-note">CURIOSITY IN ACTION</span>
      </div>
    </section>
    <section class="content-section" id="about">
      <div class="section-label"><span>01</span><b>ABOUT</b></div>
      <div class="section-body"><p class="eyebrow">A SHORT INTRODUCTION</p><h2>Curiosity into<br/><em>real work.</em></h2><p class="section-intro">{profile.about}</p><div class="skills">{profile.skills.map((skill) => <span>{skill}</span>)}</div></div>
    </section>
    <section class="content-section" id="experience">
      <div class="section-label"><span>02</span><b>EXPERIENCE</b></div>
      <div class="section-body"><p class="eyebrow">WHAT I'VE LEARNED</p><h2>People, projects,<br/>and progress.</h2>
        <div class="timeline">{profile.experience.map((item) => <article class="timeline-item"><div class="date">{item.date}</div><div><h3>{item.title}</h3><p class="org">{item.organization}</p><p>{item.summary}</p></div></article>)}</div>
        <div class="education"><div><p class="eyebrow">EDUCATION</p><h3>{profile.education.school}</h3><p>{profile.education.degree}</p></div><span>{profile.education.detail}</span></div>
      </div>
    </section>
    <section class="content-section projects-section" id="projects">
      <div class="section-label"><span>03</span><b>SELECTED WORK</b></div>
      <div class="section-body"><div class="project-heading"><div><p class="eyebrow">PROJECTS</p><h2>Things I've<br/><em>worked on.</em></h2></div><p>Coursework, personal experiments, volunteer work, and team projects can all count. Be clear about your own contribution.</p></div>
        <div class="project-grid">{profile.projects.map((project, i) => <article class="project-card"><div class="project-meta"><span>PROJECT / 0{i + 1}</span><span>↗</span></div><div class="project-art"><b>0{i + 1}</b><i></i><i></i><i></i></div><p class="project-kind">{project.kind}</p><h3>{project.title}</h3><p class="project-summary">{project.summary}</p><div class="project-skills">{project.skills.map((skill) => <span>{skill}</span>)}</div><a href={project.link} target="_blank" rel="noreferrer">Explore project ↗</a></article>)}</div>
      </div>
    </section>
    <section class="contact-section" id="contact"><div class="section-label"><span>04</span><b>CONTACT</b></div><div class="contact-body"><p class="eyebrow">HAVE A PROJECT OR OPPORTUNITY?</p><h2>Let's make<br/>something useful.</h2><a class="button primary" href={'mailto:' + profile.email}>Email me ↗</a><div class="contact-links"><a href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a><a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a></div></div></section>
  </main>
  <footer><span>© {new Date().getFullYear()} {profile.name}</span><span>Made with Astro · Published with GitHub Pages</span><a href="#top">Back to top ↑</a></footer>
</body>
</html>
<style>
:root{font-family:Roboto,Arial,sans-serif;color:#171717;background:#fff;--yellow:#FFDB00;--black:#000;--muted:#626262;--line:#deded9;--soft:#f5f5f1}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-width:320px}.topbar{min-height:76px;padding:15px clamp(18px,6vw,90px);display:flex;align-items:center;justify-content:space-between;gap:20px;border-bottom:1px solid var(--line);background:#fff}.monogram{font:700 27px 'Titillium Web',sans-serif;color:#000;text-decoration:none}.monogram span{color:#b6a000}.topbar nav{display:flex;gap:clamp(12px,2vw,28px)}.topbar nav a,.top-contact{font-size:12px;text-decoration:none;color:#333}.topbar nav a:hover,.socials a:hover,.contact-links a:hover{text-decoration:underline;text-decoration-color:#c6a900;text-underline-offset:5px}.top-contact{padding:10px 13px;background:#000;color:#fff}.hero{padding:clamp(55px,8vw,105px) clamp(18px,8vw,125px) 72px;display:grid;grid-template-columns:1.15fr .85fr;gap:35px;align-items:center;overflow:hidden}.eyebrow,.tiny-label{font:700 10px 'Titillium Web',sans-serif;letter-spacing:.15em;color:#5b5b5b}.hero h1{font:700 clamp(53px,8.5vw,110px)/.92 'Titillium Web',sans-serif;letter-spacing:-.055em;margin:18px 0 12px}.accent{color:#b7a000}.hero h2{font:600 clamp(19px,2.4vw,29px)/1.25 'Titillium Web',sans-serif;margin:0}.intro{font-size:15px;line-height:1.75;color:var(--muted);max-width:600px;margin:21px 0}.actions{display:flex;gap:10px;flex-wrap:wrap}.button{display:inline-flex;padding:12px 16px;border:1px solid #c8c8c2;border-radius:4px;text-decoration:none;font-size:12px;font-weight:700}.button.primary{background:var(--yellow);border-color:var(--yellow);color:#000}.button.secondary{background:#fff;color:#111}.socials{display:flex;gap:20px;margin-top:22px}.socials a,.contact-links a{font:11px 'DM Mono',monospace;color:#555}.hero-art{position:relative;min-height:350px;display:grid;place-items:center}.orbit{position:absolute;right:8%;top:8%;width:280px;height:280px;border-radius:50%;background:var(--yellow)}.profile-card{position:relative;width:min(300px,85%);padding:23px;background:#111;color:#fff;transform:rotate(3deg);box-shadow:0 24px 45px #0002}.tiny-label{color:#bdbdbd;font-weight:400}.initials{width:83px;height:83px;background:var(--yellow);color:#000;display:grid;place-items:center;font:700 34px 'Titillium Web',sans-serif;margin:24px 0 15px}.profile-card h3{font:700 25px 'Titillium Web',sans-serif;margin:0}.profile-card p{font-size:12px;line-height:1.5;color:#ccc}.yellow-rule{height:3px;width:48px;background:var(--yellow);margin:25px 0 12px}.vertical-note{position:absolute;right:-8px;bottom:25px;writing-mode:vertical-rl;font:9px 'DM Mono',monospace;letter-spacing:.14em;color:#555}.content-section,.contact-section{padding:63px clamp(18px,8vw,125px);display:grid;grid-template-columns:145px minmax(0,1fr);gap:30px;border-top:1px solid var(--line)}.section-label{display:flex;gap:12px;align-items:flex-start;font:700 10px 'Titillium Web',sans-serif;letter-spacing:.12em;color:#555}.section-label span{color:#a79600}.section-body h2,.contact-body h2{font:700 clamp(36px,5.5vw,64px)/.98 'Titillium Web',sans-serif;letter-spacing:-.04em;margin:8px 0 24px}.section-body h2 em{color:#777;font-weight:400;font-style:normal}.section-intro{font-size:17px;line-height:1.8;color:#555;max-width:720px}.skills{display:flex;gap:8px;flex-wrap:wrap;margin-top:24px}.skills span{padding:8px 11px;background:#efefeb;border:1px solid #ddd;border-radius:3px;font-size:11px}.timeline{border-top:1px solid var(--line);margin-top:23px}.timeline-item{display:grid;grid-template-columns:115px 1fr;gap:17px;padding:21px 0;border-bottom:1px solid var(--line)}.date{font:10px 'DM Mono',monospace;color:#777;padding-top:4px}.timeline-item h3,.education h3{font:700 18px 'Titillium Web',sans-serif;margin:0 0 3px}.timeline-item p{font-size:13px;line-height:1.65;color:#555;margin:7px 0 0}.timeline-item .org{font-weight:700;color:#222;margin-top:0}.education{display:flex;justify-content:space-between;align-items:flex-end;gap:18px;background:var(--soft);border-left:4px solid var(--yellow);padding:16px;margin-top:26px}.education h3{margin:5px 0}.education p{font-size:12px;color:#555;margin:5px 0}.education>span{font-size:10px;color:#666}.projects-section{background:#f6f6f3}.project-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:25px}.project-heading>p{max-width:300px;font-size:13px;line-height:1.7;color:#555}.project-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px;margin-top:22px}.project-card{background:#fff;border:1px solid #deded9;border-radius:6px;padding:15px;min-width:0;display:flex;flex-direction:column}.project-meta{display:flex;justify-content:space-between;font:9px 'DM Mono',monospace;color:#666}.project-art{height:120px;background:#111;display:flex;align-items:flex-end;padding:14px;gap:6px;margin:14px 0;position:relative;overflow:hidden}.project-art:before{content:'';position:absolute;width:130px;height:130px;border:1px solid #555;border-radius:50%;top:-76px;right:-15px}.project-art b{color:var(--yellow);font:700 31px 'Titillium Web',sans-serif;margin-right:auto}.project-art i{width:6px;height:40%;background:var(--yellow)}.project-art i:nth-of-type(2){height:72%}.project-art i:nth-of-type(3){height:55%}.project-kind{font:700 9px 'Titillium Web',sans-serif;letter-spacing:.1em;color:#666;margin:4px 0}.project-card h3{font:700 18px 'Titillium Web',sans-serif;margin:5px 0 8px}.project-summary{font-size:12px;line-height:1.65;color:#555;margin:0 0 12px}.project-skills{display:flex;gap:5px;flex-wrap:wrap;margin-top:auto}.project-skills span{font-size:9px;background:#eee;padding:5px 7px}.project-card>a{font:700 11px Roboto,sans-serif;color:#111;margin-top:16px}.contact-section{background:#000;color:#fff}.contact-section .section-label{color:#ddd}.contact-section .section-label span{color:var(--yellow)}.contact-body .eyebrow{color:#ccc}.contact-body h2{margin-top:10px}.contact-body .button{margin-top:5px}.contact-links{display:flex;gap:20px;margin-top:27px}.contact-links a{color:#ccc}footer{padding:22px clamp(18px,6vw,90px);background:#111;color:#ccc;display:flex;justify-content:space-between;flex-wrap:wrap;gap:14px;font-size:10px}footer a{color:var(--yellow)}
.theme-developer{background:#0c0c0c;color:#f5f5f2;--line:#303030;--soft:#191919}.theme-developer .topbar{background:#111;border-color:#333}.theme-developer .monogram,.theme-developer .hero h1,.theme-developer .section-body h2{color:#fff}.theme-developer .hero,.theme-developer .content-section{background:#0d0d0d}.theme-developer .hero h2,.theme-developer .intro,.theme-developer .section-intro,.theme-developer .timeline-item p,.theme-developer .date,.theme-developer .section-label{color:#bbb}.theme-developer .topbar nav a{color:#ddd}.theme-developer .top-contact{background:var(--yellow);color:#000}.theme-developer .profile-card{background:#1c261c;border:1px solid #374737}.theme-developer .orbit{background:#bfe54a}.theme-developer .skills span{background:#191919;border-color:#444;color:#ddd}.theme-developer .projects-section{background:#151515}.theme-developer .project-card,.theme-developer .education{background:#1b1b1b;border-color:#393939}.theme-developer .project-card h3,.theme-developer .education h3{color:#fff}.theme-developer .project-summary,.theme-developer .education p{color:#bbb}.theme-developer footer{background:#050505}.theme-professional .hero{background:#eef2f6}.theme-professional .orbit{background:#d4deeb}.theme-professional .profile-card{background:#20456b}.theme-professional .initials{background:#fff;color:#20456b}.theme-professional .yellow-rule{background:#fff}.theme-professional .button.primary{background:#000;color:#fff;border-color:#000}.theme-professional .section-body h2 em{color:#315b84}.theme-professional .project-art{background:#244c75}.theme-professional .project-art b,.theme-professional .project-art i{color:#fff;background:#fff}.theme-professional .contact-section{background:#172e45}
@media(max-width:760px){.hero{grid-template-columns:1fr;padding-top:48px}.hero-art{min-height:270px}.orbit{width:225px;height:225px}.profile-card{width:255px}.content-section,.contact-section{grid-template-columns:1fr;gap:18px;padding-top:42px;padding-bottom:45px}.section-body h2,.contact-body h2{font-size:44px}.project-grid{grid-template-columns:1fr}.project-art{height:150px}.project-heading{display:block}.topbar{height:auto;flex-wrap:wrap;padding:15px 18px}.topbar nav{order:3;width:100%;overflow:auto;padding-top:8px}.topbar nav a{white-space:nowrap}.top-contact{margin-left:auto}.timeline-item{grid-template-columns:95px 1fr}.education{flex-direction:column;align-items:flex-start}}
</style>
